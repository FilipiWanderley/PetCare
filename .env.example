
# --- Application ---
# URL pública da aplicação (usado para links de email, auth redirects, etc)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Prisma) ---
# Connection string para o banco de dados (PostgreSQL)
# Exemplo PostgreSQL (Local): postgresql://user:password@localhost:5432/petcare?schema=public
# Exemplo Vercel Postgres: postgres://default:password@ep-url.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require
# Exemplo Neon: postgres://user:password@ep-url.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:port/mydb?schema=public"

# --- Security ---
# Chave secreta para assinatura de tokens JWT (sessão)
# Gere uma chave forte: openssl rand -base64 32
JWT_SECRET="super-secret-jwt-key-change-me-in-prod"

# Segredo para proteger rotas administrativas (seed, diagnose)
# Se não definido, essas rotas ficam desabilitadas
ADMIN_SECRET="admin-secret-key"

# Credenciais para criar o primeiro admin via seed (opcional)
ADMIN_EMAIL="admin@petcare.com"
ADMIN_PASSWORD="secure-password-123"

# --- Stripe (Payments) ---
# Chaves da API do Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Segredo do Webhook para validar eventos do Stripe (opcional em dev, crucial em prod)
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email ---
# Recomendado: Resend (https://resend.com)
# Se definido, o sistema usará a API do Resend (mais robusto para serverless)
RESEND_API_KEY="re_123456789"
# Endereço de envio verificado no Resend
EMAIL_FROM="Pet Care <onboarding@resend.dev>"

# Alternativa: SMTP (Legacy/Custom)
# Se RESEND_API_KEY não estiver definido, o sistema tentará usar SMTP
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
