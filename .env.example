# Database Configuration (PostgreSQL recommended for Vercel)
# Ex: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public"

# Authentication
# Generate a secure random string for JWT encryption (e.g., use `openssl rand -base64 32`)
JWT_SECRET="sua-chave-secreta-segura-aqui"

# Application URL
# In production (Vercel), this should be your deployment URL (e.g., https://seu-projeto.vercel.app)
# In development, it defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Configuration (Optional for Dev, Required for Prod Email Sending)
# If not provided in Prod, emails will be logged to console (not recommended)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="password"
